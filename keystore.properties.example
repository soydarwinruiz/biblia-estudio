# Copia este archivo como «keystore.properties» (está en .gitignore y NO se sube a GitHub)
# y escribe la contraseña de la clave nueva (desde la 1.7). La clave keystore/codice-vivo.jks
# tampoco se sube: guárdala en un lugar seguro; sin ella no se pueden publicar actualizaciones.
storeFile=keystore/codice-vivo.jks
storePassword=ESCRIBE_AQUI_LA_CONTRASEÑA
keyAlias=codice
keyPassword=ESCRIBE_AQUI_LA_CONTRASEÑA
