<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: solo datos personales (ver backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user_data.db" />
        <include domain="database" path="user_data.db-wal" />
        <include domain="database" path="user_data.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user_data.db" />
        <include domain="database" path="user_data.db-wal" />
        <include domain="database" path="user_data.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
