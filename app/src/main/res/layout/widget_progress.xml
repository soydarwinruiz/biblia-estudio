<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/pw_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2E1A0C" android:textSize="20sp" android:textStyle="bold" android:text="🔥 0" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7A4A1E" android:textSize="11sp" android:text="racha" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pw_plan_box" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/pw_plan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2E1A0C" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:text="—" />
        <TextView android:id="@+id/pw_plan_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7A4A1E" android:textSize="11sp" android:text="lectura de hoy" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pw_memory_box" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/pw_memory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#2E1A0C" android:textSize="20sp" android:textStyle="bold" android:text="🧠 0" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7A4A1E" android:textSize="11sp" android:text="por repasar" />
    </LinearLayout>
</LinearLayout>
